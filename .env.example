# CelenganKu - NestJS Backend Configuration

# Server Port (Default 4000 to avoid collision with Next.js on 3000)
PORT=4000

# Default User ID for Single User / Demo Mode
DEFAULT_USER_ID=user_id_123

# Firebase Realtime Database URL
# Format: https://<project-id>-default-rtdb.asia-southeast1.firebasedatabase.app
# OR: https://<project-id>-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://celenganku-demo-default-rtdb.firebaseio.com

# (Optional) Firebase Database Secret or Auth Token if rules require auth
FIREBASE_DATABASE_AUTH=

# (Optional) Path to serviceAccountKey.json if using Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=

